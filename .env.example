# Set secrets in the hosting provider, not in source control.
NODE_ENV=production
APP_ORIGIN=https://app.never86.app
SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
# Google is optional; configure both fields and register the callback if offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional storage namespace; keep it stable across replicas and deployments.
DATA_NAMESPACE=one-seat
